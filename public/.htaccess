<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No redirigir archivos ni directorios existentes (assets, sw.js, manifest.json, imágenes)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir todas las rutas (/admin, /player, etc.) a index.html para React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Compresión GZIP para carga ultrarrápida en Smart TVs y Fire TV Sticks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml
</IfModule>

# Caché de activos estáticos (excepto index.html y sw.js para que siempre detecten actualizaciones)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Evitar caché del Service Worker para que las pantallas reciban nuevas versiones al instante
<FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>

